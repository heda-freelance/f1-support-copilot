DATABASE_URL=postgres://copilot:copilot@localhost:5432/copilot

# --- Provider selection ---
# openai (default) | local
MODEL_PROVIDER=openai

# --- OpenAI provider (MODEL_PROVIDER=openai) ---
OPENAI_API_KEY=
COHERE_API_KEY=

# --- Local provider (MODEL_PROVIDER=local) ---
# Three llama-server processes, all OpenAI-compatible /v1 routes.
LOCAL_LLM_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=default
LOCAL_EMBED_URL=http://localhost:8081/v1
LOCAL_EMBED_MODEL=default
# bge-base-en-v1.5 → 768 dims
LOCAL_EMBED_DIM=768
# Reranker root URL; /v1/rerank is appended in code.
LOCAL_RERANK_URL=http://localhost:8082
LOCAL_RERANK_MODEL=default

# --- Slack ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

NODE_ENV=development
