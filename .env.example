DATABASE_URL=postgres://copilot:copilot@localhost:5432/copilot

# --- Provider selection ---
# openai (default) | local
MODEL_PROVIDER=openai

# --- OpenAI provider (MODEL_PROVIDER=openai) ---
OPENAI_API_KEY=
COHERE_API_KEY=

# --- Local provider (MODEL_PROVIDER=local) ---
# llama.cpp server, OpenAI-compatible /v1
LOCAL_LLM_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=default
# TEI embedding server (Hugging Face Text Embeddings Inference)
LOCAL_EMBED_URL=http://localhost:8081
# bge-base-en-v1.5 → 768 dims
LOCAL_EMBED_DIM=768
# TEI reranker server
LOCAL_RERANK_URL=http://localhost:8082

# --- Slack ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

NODE_ENV=development
